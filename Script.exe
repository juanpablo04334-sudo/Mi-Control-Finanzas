 
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Control de Finanzas Personales</title>
  <meta name="description" content="Aplicación visual para registrar gastos, ganancias y organizar tus finanzas personales." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg:#f4f1ea;
      --bg-soft:#efe9dd;
      --surface:rgba(255,255,255,0.58);
      --surface-strong:rgba(255,255,255,0.78);
      --text:#18161a;
      --muted:#5f5a63;
      --line:rgba(24,22,26,0.08);
      --accent:#1e9b7b;
      --accent-2:#d98a3d;
      --danger:#cc4d4d;
      --success:#0f8f68;
      --shadow:0 20px 60px rgba(33, 24, 15, 0.09);
      --radius:24px;
      --radius-sm:16px;
      --max:1280px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:"Manrope", sans-serif;
      background:
        radial-gradient(circle at 10% 15%, rgba(217,138,61,0.14), transparent 28%),
        radial-gradient(circle at 85% 10%, rgba(30,155,123,0.15), transparent 24%),
        radial-gradient(circle at 70% 80%, rgba(24,22,26,0.05), transparent 25%),
        linear-gradient(180deg, #f7f3ec 0%, #f4f1ea 100%);
      color:var(--text);
      min-height:100vh;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.35;
      background-image:
        linear-gradient(rgba(24,22,26,0.02) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24,22,26,0.02) 1px, transparent 1px);
      background-size:28px 28px;
      mask-image:linear-gradient(to bottom, rgba(0,0,0,.4), transparent 85%);
    }

    a{text-decoration:none;color:inherit}
    button,input,select{font:inherit}
    .wrap{width:min(calc(100% - 2rem), var(--max)); margin-inline:auto}

    .reveal{
      opacity:0;
      transform:translateY(22px);
      transition:opacity .8s ease, transform .8s ease;
    }
    .reveal.visible{
      opacity:1;
      transform:translateY(0);
    }

    .topbar{
      position:sticky;
      top:0;
      z-index:40;
      backdrop-filter:blur(14px);
      background:rgba(244,241,234,0.7);
      border-bottom:1px solid rgba(24,22,26,0.06);
    }

    .topbar-inner{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:1rem;
      padding:1rem 0;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:.9rem;
    }

    .brand-mark{
      width:44px;
      height:44px;
      border-radius:14px;
      background:
        linear-gradient(135deg, var(--accent), #63c6aa 65%),
        linear-gradient(180deg, #fff, #ddd);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.7),
        0 12px 28px rgba(30,155,123,.22);
      position:relative;
      overflow:hidden;
    }

    .brand-mark::before,
    .brand-mark::after{
      content:"";
      position:absolute;
      border-radius:999px;
      background:rgba(255,255,255,.85);
    }

    .brand-mark::before{
      width:8px;
      height:18px;
      left:12px;
      bottom:10px;
      box-shadow:12px -5px 0 0 rgba(255,255,255,.85);
    }

    .brand-mark::after{
      width:26px;
      height:2px;
      left:9px;
      bottom:9px;
    }

    .brand-text strong{
      display:block;
      font-family:"Space Grotesk", sans-serif;
      font-weight:700;
      letter-spacing:-0.04em;
      font-size:1rem;
    }

    .brand-text span{
      color:var(--muted);
      font-size:.88rem;
    }

    .nav{
      display:flex;
      gap:1rem;
      flex-wrap:wrap;
      align-items:center;
    }

    .nav a{
      color:var(--muted);
      font-weight:700;
      font-size:.95rem;
      position:relative;
    }

    .nav a::after{
      content:"";
      position:absolute;
      left:0;
      bottom:-4px;
      width:0;
      height:2px;
      background:var(--text);
      transition:width .25s ease;
    }

    .nav a:hover::after{width:100%}

    .hero{
      padding:clamp(2.5rem, 4vw, 4rem) 0 1.5rem;
    }

    .hero-grid{
      display:grid;
      grid-template-columns:1.1fr .9fr;
      gap:1.25rem;
      align-items:stretch;
    }

    .hero-copy,
    .hero-panel,
    .panel,
    .wide-panel,
    .list-panel{
      background:var(--surface);
      border:1px solid rgba(255,255,255,0.55);
      backdrop-filter:blur(16px);
      box-shadow:var(--shadow);
      border-radius:var(--radius);
    }

    .hero-copy{
      padding:clamp(1.5rem, 4vw, 3rem);
      min-height:520px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      position:relative;
      overflow:hidden;
    }

    .eyebrow{
      display:inline-flex;
      width:max-content;
      align-items:center;
      gap:.55rem;
      padding:.55rem .85rem;
      border-radius:999px;
      background:rgba(255,255,255,.55);
      border:1px solid rgba(24,22,26,.06);
      color:var(--muted);
      font-size:.86rem;
      font-weight:800;
      letter-spacing:.03em;
      text-transform:uppercase;
    }

    .eyebrow i{
      width:8px;
      height:8px;
      border-radius:50%;
      background:var(--accent);
      box-shadow:0 0 0 6px rgba(30,155,123,.14);
    }

    h1,h2,h3{
      font-family:"Space Grotesk", sans-serif;
      letter-spacing:-0.05em;
      line-height:.95;
      margin:0;
    }

    h1{
      font-size:clamp(3rem, 8vw, 6.3rem);
      max-width:10ch;
      margin-top:1rem;
    }

    .hero-copy p{
      max-width:58ch;
      font-size:clamp(1rem, 1.5vw, 1.12rem);
      color:var(--muted);
      line-height:1.7;
      margin:1.1rem 0 0;
    }

    .hero-actions{
      display:flex;
      flex-wrap:wrap;
      gap:.9rem;
      margin-top:1.7rem;
    }

    .btn{
      appearance:none;
      border:none;
      cursor:pointer;
      padding:1rem 1.3rem;
      border-radius:18px;
      font-weight:800;
      transition:transform .2s ease, box-shadow .2s ease, background .2s ease, color .2s ease;
    }

    .btn:active{transform:scale(.98)}

    .btn-primary{
      background:var(--text);
      color:#fff;
      box-shadow:0 14px 30px rgba(24,22,26,.16);
    }

    .btn-primary:hover{
      transform:translateY(-2px);
      box-shadow:0 18px 34px rgba(24,22,26,.22);
    }

    .btn-secondary{
      background:rgba(255,255,255,.7);
      color:var(--text);
      border:1px solid rgba(24,22,26,.08);
    }

    .btn-secondary:hover{
      transform:translateY(-2px);
      background:#fff;
    }

    .hero-stats{
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:.8rem;
      margin-top:2rem;
    }

    .mini-stat{
      padding:1rem;
      background:rgba(255,255,255,.55);
      border:1px solid rgba(24,22,26,.06);
      border-radius:18px;
    }

    .mini-stat span{
      display:block;
      color:var(--muted);
      font-size:.82rem;
      margin-bottom:.3rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    .mini-stat strong{
      font-size:1.25rem;
      font-family:"Space Grotesk", sans-serif;
    }

    .hero-panel{
      padding:1.2rem;
      min-height:520px;
      display:grid;
      grid-template-rows:auto 1fr auto;
      gap:1rem;
    }

    .panel-top{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:1rem;
    }

    .panel-top strong{
      font-size:1rem;
      font-family:"Space Grotesk", sans-serif;
    }

    .badge{
      padding:.45rem .7rem;
      border-radius:999px;
      background:rgba(30,155,123,.12);
      color:var(--success);
      font-weight:800;
      font-size:.8rem;
    }

    .chart-box{
      border-radius:22px;
      background:
        linear-gradient(180deg, rgba(255,255,255,.75), rgba(255,255,255,.45)),
        linear-gradient(180deg, rgba(30,155,123,.08), rgba(217,138,61,.08));
      border:1px solid rgba(24,22,26,.06);
      padding:1rem;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      overflow:hidden;
      position:relative;
    }

    .chart-box::before{
      content:"";
      position:absolute;
      inset:0;
      background:
        linear-gradient(rgba(24,22,26,.06) 1px, transparent 1px),
        linear-gradient(90deg, rgba(24,22,26,.05) 1px, transparent 1px);
      background-size:100% 25%, 20% 100%;
      opacity:.25;
      pointer-events:none;
    }

    .chart-svg{
      width:100%;
      height:220px;
      display:block;
      margin-top:.5rem;
      position:relative;
      z-index:1;
    }

    .chart-legend{
      display:flex;
      gap:1rem;
      flex-wrap:wrap;
      color:var(--muted);
      font-size:.88rem;
      position:relative;
      z-index:1;
    }

    .chart-legend b{
      color:var(--text);
      margin-left:.35rem;
    }

    .panel-bottom{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:.8rem;
    }

    .finance-chip{
      border-radius:18px;
      padding:1rem;
      background:rgba(255,255,255,.65);
      border:1px solid rgba(24,22,26,.06);
    }

    .finance-chip small{
      display:block;
      color:var(--muted);
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.04em;
      margin-bottom:.3rem;
    }

    .finance-chip strong{
      font-family:"Space Grotesk", sans-serif;
      font-size:1.35rem;
    }

    .grid-section{
      padding:1rem 0 1.2rem;
    }

    .dashboard{
      display:grid;
      grid-template-columns:1.05fr .95fr;
      gap:1.25rem;
    }

    .panel,
    .wide-panel,
    .list-panel{
      padding:1.2rem;
    }

    .section-head{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap:1rem;
      margin-bottom:1rem;
    }

    .section-head h2{
      font-size:clamp(1.8rem, 3vw, 3rem);
    }

    .section-head p{
      margin:0;
      color:var(--muted);
      max-width:42ch;
      line-height:1.6;
    }

    .summary-grid{
      display:grid;
      grid-template-columns:repeat(2,1fr);
      gap:.9rem;
      margin-top:1rem;
    }

    .summary-item{
      min-height:140px;
      border-radius:22px;
      padding:1.1rem;
      border:1px solid rgba(24,22,26,.06);
      background:linear-gradient(180deg, rgba(255,255,255,.72), rgba(255,255,255,.44));
      display:flex;
      flex-direction:column;
      justify-content:space-between;
    }

    .summary-item:nth-child(1){background:linear-gradient(180deg, rgba(30,155,123,.12), rgba(255,255,255,.5))}
    .summary-item:nth-child(2){background:linear-gradient(180deg, rgba(217,138,61,.14), rgba(255,255,255,.5))}
    .summary-item:nth-child(3){background:linear-gradient(180deg, rgba(24,22,26,.06), rgba(255,255,255,.5))}
    .summary-item:nth-child(4){background:linear-gradient(180deg, rgba(204,77,77,.10), rgba(255,255,255,.5))}

    .summary-item span{
      color:var(--muted);
      font-size:.84rem;
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .summary-item strong{
      font-family:"Space Grotesk", sans-serif;
      font-size:clamp(1.5rem, 3vw, 2.2rem);
    }

    .summary-item em{
      font-style:normal;
      color:var(--muted);
      font-size:.9rem;
    }

    .organizer{
      display:grid;
      gap:.9rem;
    }

    .task{
      display:grid;
      grid-template-columns:auto 1fr auto;
      gap:.9rem;
      align-items:center;
      padding:1rem;
      border-radius:18px;
      background:rgba(255,255,255,.62);
      border:1px solid rgba(24,22,26,.06);
      transition:transform .2s ease, background .2s ease, opacity .2s ease;
    }

    .task:hover{transform:translateX(4px)}

    .task.done{
      opacity:.65;
      background:rgba(255,255,255,.4);
    }

    .task input[type="checkbox"]{
      width:20px;
      height:20px;
      accent-color:var(--accent);
      cursor:pointer;
    }

    .task strong{
      display:block;
      font-size:1rem;
    }

    .task span{
      color:var(--muted);
      font-size:.92rem;
    }

    .pill{
      padding:.45rem .7rem;
      border-radius:999px;
      font-size:.78rem;
      font-weight:800;
      letter-spacing:.03em;
      text-transform:uppercase;
      background:rgba(24,22,26,.06);
      color:var(--muted);
      white-space:nowrap;
    }

    .pill.high{background:rgba(204,77,77,.12); color:var(--danger)}
    .pill.medium{background:rgba(217,138,61,.14); color:#9b5f20}
    .pill.low{background:rgba(30,155,123,.13); color:var(--success)}

    .planner{
      padding:1.2rem;
      border-radius:22px;
      background:rgba(255,255,255,.58);
      border:1px solid rgba(24,22,26,.06);
      margin-top:1rem;
    }

    .planner form{
      display:grid;
      grid-template-columns:1.2fr .8fr auto;
      gap:.75rem;
      align-items:end;
    }

    .field{
      display:grid;
      gap:.35rem;
    }

    .field label{
      font-size:.86rem;
      color:var(--muted);
      font-weight:800;
      text-transform:uppercase;
      letter-spacing:.04em;
    }

    .field input,
    .field select{
      width:100%;
      border:none;
      outline:none;
      padding:1rem 1rem;
      border-radius:16px;
      background:rgba(255,255,255,.86);
      border:1px solid rgba(24,22,26,.08);
      color:var(--text);
      transition:border-color .2s ease, transform .2s ease, box-shadow .2s ease;
    }

    .field input:focus,
    .field select:focus{
      border-color:rgba(30,155,123,.45);
      box-shadow:0 0 0 4px rgba(30,155,123,.12);
      transform:translateY(-1px);
    }

    .transactions{
      display:grid;
      gap:.8rem;
      margin-top:1rem;
    }

    .tx{
      display:grid;
      grid-template-columns:1fr auto auto;
      gap:1rem;
      align-items:center;
      padding:1rem;
      border-radius:18px;
      background:rgba(255,255,255,.62);
      border:1px solid rgba(24,22,26,.06);
      transition:transform .2s ease, box-shadow .2s ease;
    }

    .tx:hover{
      transform:translateY(-2px);
      box-shadow:0 16px 30px rgba(24,22,26,.06);
    }

    .tx-meta strong{
      display:block;
      font-size:1rem;
      margin-bottom:.15rem;
    }

    .tx-meta span{
      color:var(--muted);
      font-size:.9rem;
    }

    .tx-type{
      font-weight:800;
      text-transform:uppercase;
      font-size:.78rem;
      letter-spacing:.05em;
      color:var(--muted);
    }

    .tx-amount{
      font-family:"Space Grotesk", sans-serif;
      font-weight:700;
      font-size:1.18rem;
      text-align:right;
    }

    .tx.income .tx-amount{color:var(--success)}
    .tx.expense .tx-amount{color:var(--danger)}

    .footer{
      padding:2rem 0 3rem;
      color:var(--muted);
    }

    .footer-box{
      display:flex;
      justify-content:space-between;
      gap:1rem;
      flex-wrap:wrap;
      padding-top:1rem;
      border-top:1px solid rgba(24,22,26,.08);
    }

    .stagger > *{
      opacity:0;
      transform:translateY(18px);
      animation:rise .7s ease forwards;
    }

    .stagger > *:nth-child(1){animation-delay:.06s}
    .stagger > *:nth-child(2){animation-delay:.14s}
    .stagger > *:nth-child(3){animation-delay:.22s}
    .stagger > *:nth-child(4){animation-delay:.30s}
    .stagger > *:nth-child(5){animation-delay:.38s}
    .stagger > *:nth-child(6){animation-delay:.46s}

    @keyframes rise{
      to{
        opacity:1;
        transform:translateY(0);
      }
    }

    @media (max-width: 1080px){
      .hero-grid,
      .dashboard{
        grid-template-columns:1fr;
      }
      .hero-copy,
      .hero-panel{min-height:auto}
    }

    @media (max-width: 720px){
      .topbar-inner{align-items:flex-start; flex-direction:column}
      .nav{gap:.8rem}
      .hero-stats,
      .summary-grid,
      .panel-bottom{
        grid-template-columns:1fr;
      }
      .planner form{
        grid-template-columns:1fr;
      }
      .tx{
        grid-template-columns:1fr;
        align-items:flex-start;
      }
      .tx-amount{text-align:left}
      h1{max-width:12ch}
    }
  </style>
</head>
<body>
  <header class="topbar">
    <div class="wrap topbar-inner">
      <div class="brand">
        <div class="brand-mark" aria-hidden="true"></div>
        <div class="brand-text">
          <strong>Mi Control</strong>
          <span>Gastos, ganancias y organización</span>
        </div>
      </div>
      <nav class="nav" aria-label="Navegación principal">
        <a href="#resumen">Resumen</a>
        <a href="#movimientos">Movimientos</a>
        <a href="#organizacion">Organización</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <article class="hero-copy stagger">
          <div>
            <div class="eyebrow"><i></i> Tu panel financiero personal</div>
            <h1>Ve tus gastos, tus ganancias y ordénate mejor.</h1>
            <p>
              Una aplicación simple y elegante para entender cómo entra y sale tu dinero.
              Registra movimientos, revisa tu balance total y mantén tus pendientes financieros bajo control en un solo lugar.
            </p>
            <div class="hero-actions">
              <a class="btn btn-primary" href="#movimientos">Empezar ahora</a>
              <a class="btn btn-secondary" href="#organizacion">Ver organización</a>
            </div>
          </div>

          <div class="hero-stats">
            <div class="mini-stat">
              <span>Balance actual</span>
              <strong id="heroBalance">$0</strong>
            </div>
            <div class="mini-stat">
              <span>Ganancias</span>
              <strong id="heroIncome">$0</strong>
            </div>
            <div class="mini-stat">
              <span>Gastos</span>
              <strong id="heroExpense">$0</strong>
            </div>
          </div>
        </article>

        <aside class="hero-panel stagger" aria-label="Vista general del progreso">
          <div class="panel-top">
            <strong>Panorama mensual</strong>
            <span class="badge">Actualizado en vivo</span>
          </div>

          <div class="chart-box">
            <div class="chart-legend">
              <span>Ingresos <b id="legendIncome">$0</b></span>
              <span>Gastos <b id="legendExpense">$0</b></span>
              <span>Balance <b id="legendBalance">$0</b></span>
            </div>

            <svg class="chart-svg" viewBox="0 0 520 220" role="img" aria-label="Gráfico comparativo entre ingresos y gastos">
              <defs>
                <linearGradient id="incomeStroke" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#1e9b7b"/>
                  <stop offset="100%" stop-color="#7dd6bd"/>
                </linearGradient>
                <linearGradient id="expenseStroke" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#d98a3d"/>
                  <stop offset="100%" stop-color="#f0bf7c"/>
                </linearGradient>
              </defs>

              <polyline id="incomeLine" fill="none" stroke="url(#incomeStroke)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"
                points="20,170 100,135 180,120 260,90 340,80 420,55 500,40"></polyline>

              <polyline id="expenseLine" fill="none" stroke="url(#expenseStroke)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"
                points="20,178 100,168 180,150 260,142 340,130 420,120 500,110"></polyline>

              <g fill="#1e9b7b" id="incomeDots">
                <circle cx="20" cy="170" r="5"></circle>
                <circle cx="100" cy="135" r="5"></circle>
                <circle cx="180" cy="120" r="5"></circle>
                <circle cx="260" cy="90" r="5"></circle>
                <circle cx="340" cy
